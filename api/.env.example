# Copy to .env for local development. In the cloud, set these as environment variables.
ENVIRONMENT=local
LOG_LEVEL=INFO

# Either a full URL...
# DATABASE_URL=postgresql+asyncpg://jmil:jmil@localhost:5432/jmil
# ...or separate parts:
DB_HOST=localhost
DB_PORT=5432
DB_USER=jmil
DB_PASSWORD=jmil
DB_NAME=jmil

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:5173
